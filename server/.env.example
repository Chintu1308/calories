# ==========================================
# CALORIES SERVER — ENVIRONMENT CONFIGURATION
# Copy to server/.env for local backend development.
# NEVER COMMIT REAL SECRETS OR server/.env TO GIT.
# ==========================================

PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/calories
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars
AI_SERVICE_URL=http://localhost:5001
GEMINI_API_KEY=your_gemini_api_key_here
