# ==========================================
# CALORIES PLATFORM — ENVIRONMENT CONFIGURATION
# Copy to .env for local development.
# NEVER COMMIT REAL SECRETS OR .env TO GIT.
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database (MongoDB Atlas / Local MongoDB)
# Atlas Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/calories?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/calories

# Authentication (JWT Secret - minimum 256 bits / 32 random characters)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars

# AI Extraction Microservice
AI_SERVICE_URL=http://localhost:5001

# AI Provider API Key (server-side only, never expose to client bundle)
GEMINI_API_KEY=your_gemini_api_key_here
